# lab-tester node configuration
# Copy this file to /etc/lab-tester/config and edit as needed.
#
# In normal use you do not edit this by hand: setup.sh writes the file from
# VMware guestinfo keys set on the node's VM in vCenter. Precedence for each
# value is guestinfo -> environment variable -> interactive prompt.
#
#   guestinfo.lab.hub_url    ->  HUB_URL
#   guestinfo.lab.group      ->  GROUP_NAME
#   guestinfo.lab.subnet     ->  SUBNET
#   guestinfo.lab.hostname   ->  LAB_HOSTNAME   (optional)
#   guestinfo.lab.dns_server ->  DNS_SERVER     (optional)
#   guestinfo.lab.dns_query  ->  DNS_QUERY      (optional)

# URL of the hub (no trailing slash)
# Example: http://10.0.0.100
HUB_URL=http://10.0.0.100

# Group label for this node — an arbitrary tag used to cluster nodes on the
# dashboard and to filter syslog by sender. Example: site-a, site-b, rack1.
GROUP_NAME=site-a

# Subnet of this node's interface (CIDR notation)
# Example: 10.1.1.0/24
SUBNET=10.1.1.0/24

# ---------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------

# Explicit hostname for this node. Leave empty to derive it as
# <HOSTNAME_PREFIX>-<group>, e.g. test-site-a.
#
# It must be unique across the lab: the hub keys its endpoint table by
# hostname, so two nodes sharing a name overwrite each other and the mesh
# collapses to a single entry.
LAB_HOSTNAME=

HOSTNAME_PREFIX=test

# ---------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------

# How often to run traceroute, in seconds. It is far more expensive than the
# other tests and is diagnostic rather than continuous, so it runs on this
# slower schedule — and additionally whenever an HTTP or SSH test to a target
# has just failed, which is when the path detail is actually wanted.
TRACEROUTE_INTERVAL=300

# Maximum traceroute hops. Keep this tight: every unanswered hop costs
# roughly the probe timeout, so a large value makes a black-holed path
# expensive to measure.
TRACEROUTE_MAX_HOPS=10

# Payload size for the path-MTU probe, in bytes. 1472 payload + 28 bytes of
# IP/ICMP header = 1500, the standard Ethernet MTU. Lower this if your lab
# runs a smaller baseline MTU.
#
# This is the test that catches a tunnel where the peering is up and small
# packets pass but large transfers hang — every other test here uses small
# payloads and reads green straight through that fault.
PMTU_SIZE=1472

# Enable iperf3 bandwidth tests (true/false).
# Note that iperf3 saturates the link for the duration of each test, which
# will inflate the latency figures other nodes record at the same moment.
ENABLE_IPERF=false

# Enable the SMB probe test (true/false). Every node runs a Samba server
# (lab-smbd) exporting one small read-only share, and every peer fetches a
# fixed probe file from it. SMB is chatty and session-oriented, so it is the
# test most likely to catch an inspection policy or a NAT/MTU problem that
# HTTP, SSH and iperf3 miss.
#
# Two costs to weigh before enabling on a 128 MB node: smbd's own resident
# memory while running, and up to ~15s added to the per-peer cycle budget
# (the outer `timeout 15` in run_smb_test, fetching an 8 MB probe file).
ENABLE_SMB=false

# Enable the SMTP probe test (true/false). Every node runs an OpenSMTPD
# server (lab-smtpd), and every peer holds a lightweight conversation
# against it: banner -> EHLO -> MAIL FROM -> RCPT TO -> RSET -> QUIT. It
# catches SMTP ALG / ESMTP inspection — common on firewalls and NAT gateways
# — masking unrecognised capability verbs (e.g. STARTTLS) with runs of X —
# a device that PASSES SMTP while silently rewriting it, which nothing else
# here would notice.
#
# Safety: the probe never issues DATA — it aborts the transaction with RSET
# right after the envelope. lab-smtpd's own config has no relay action, so
# even a real client that completed DATA against it could not have that
# message forwarded anywhere. This cannot send mail, including against a
# real external relay registered as a static target (that arm is
# intentionally ungated — see test-cycle.sh's static-target case).
#
# Costs on a 128 MB node: OpenSMTPD is multi-process (parent, lka, queue,
# scheduler, dispatcher, control, ca — roughly 7 privileged-separation
# processes versus smbd's fork-per-connection model), so measure its
# resident memory alongside ENABLE_SMB if both are enabled on the same node.
# Typical cost is ~3s per peer in the cycle budget (two deliberate 1s pauses
# plus connection/round-trip time), up to ~10s worst case (SMTP_TIMEOUT).
ENABLE_SMTP=false

# SMTP probe tuning — defaults are inline in run_smtp_test(); uncomment to
# override.
#SMTP_PORT=25
#SMTP_HELO=
#SMTP_MAIL_FROM=
#SMTP_RCPT=probe@lab.invalid
#SMTP_TIMEOUT=10

# Loss/jitter probe (fping) tuning — always on, no ENABLE_* flag. Defaults
# are inline in run_loss_test(); uncomment to override. Fewer/shorter probes
# reduce per-peer cycle cost at the price of loss-percentage resolution
# (10 probes = 10% resolution).
#LOSS_COUNT=10
#LOSS_PERIOD_MS=100
#LOSS_TIMEOUT_MS=500

# DNS resolver to query, e.g. 10.0.0.53. Leave empty to skip the DNS test
# entirely — labs without DNS in the topology then see no red cells for it.
DNS_SERVER=

# Name to resolve when DNS_SERVER is set.
DNS_QUERY=example.com

# ---------------------------------------------------------------------
# Maintenance
# ---------------------------------------------------------------------

# Pull agent script updates from the hub on each registration run (every 5
# minutes), so scripts are edited in one place rather than on every node.
#
# An update is only accepted if it matches the hub's published sha256, parses
# as valid shell, and (for test-cycle.sh) runs successfully. The previous
# version is kept as .known-good and restored if that run fails.
#
# Set to false to pin this node to whatever it currently has.
AGENT_AUTOUPDATE=true
